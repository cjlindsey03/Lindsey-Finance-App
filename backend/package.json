{
  "name": "lindsey-finance-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Lambda functions for the Lindsey household financial dashboard",
  "scripts": {
    "local-api": "sam local start-api --env-vars env.local.json --docker-network sam-local",
    "build": "npm run bundle && sam build",
    "bundle": "node scripts/bundle.js",
    "seed": "node scripts/seed-accounts.js --local"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.600.0",
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/client-sns": "^3.600.0",
    "@aws-sdk/lib-dynamodb": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.1127.0",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
